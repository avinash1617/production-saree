# Copy this file to .env, set strong unique secrets, then keep .env out of Git.
NODE_ENV=production
PORT=5000

# Local Docker MongoDB credentials. Use long random alphanumeric values.
MONGO_ROOT_USERNAME=nihira_admin
MONGO_ROOT_PASSWORD=replace_with_a_long_random_alphanumeric_password
MONGO_APP_USERNAME=nihira_store
MONGO_APP_PASSWORD=replace_with_another_long_random_alphanumeric_password
MONGODB_URI=mongodb://nihira_admin:replace_with_a_long_random_alphanumeric_password@localhost:27017/nihira_looms?authSource=admin

# Generate a random secret with at least 32 characters.
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters

# The browser origin(s) allowed to call the API.
APP_ORIGINS=http://localhost:8080

# Add Razorpay TEST credentials first. Never commit live credentials.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ₹99 delivery; free delivery for orders of ₹1,999 or more.
SHIPPING_FEE_PAISE=9900
FREE_SHIPPING_THRESHOLD_PAISE=199900

# Set these temporarily when creating the first admin account.
ADMIN_EMAIL=
ADMIN_PASSWORD=
